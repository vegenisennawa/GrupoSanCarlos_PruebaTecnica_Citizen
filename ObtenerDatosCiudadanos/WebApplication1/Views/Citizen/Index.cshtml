@model IEnumerable<WebApplication1.Controllers.CitizenViewModel>

@{ ViewData["Title"] = "Consulta de Ciudadanos"; }

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-users me-2"></i>@ViewData["Title"]</h4>
            <span class="badge bg-primary">Registros cargados: @Model.Count()</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido Paterno</th>
                            <th>Apellido Materno</th>
                            <th>Sexo</th>
                            <th>Edo. Nac.</th>
                            <th>Fecha Nac.</th>
                            <th>RFC (Comp)</th>
                            <th>RFC (Cal)</th>
                            <th>CURP (Comp)</th>
                            <th>CURP (Cal)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var citizen in Model)
                        {
                        <tr>
                            <td>@citizen.Nombre</td>
                            <td>@citizen.Apellido_Paterno</td>
                            <td>@citizen.Apellido_Materno</td>
                            <td>@citizen.Sexo</td>
                            <td class="text-center">@citizen.Clave_Edo_Nac</td>
                            <td>@citizen.Fecha_Nac</td>
                            <td><code class="text-dark">@citizen.Rfc_Comparacion</code></td>
                            <td><code class="text-dark">@citizen.Rfc_Calculado</code></td>
                            <td><code class="text-dark">@citizen.Curp_Comparacion</code></td>
                            <td><strong class="text-primary">@citizen.Curp_Calculada</strong></td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
